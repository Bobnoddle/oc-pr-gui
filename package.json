{
  "name": "oc-pr-gui",
  "version": "0.5.0",
  "description": "OpenCode Desktop side panel for the current branch's pull request: state, checks, guarded merge, and a reversible merged-branch tidy pass.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bobnoddle/oc-pr-gui.git"
  },
  "homepage": "https://github.com/Bobnoddle/oc-pr-gui#readme",
  "bugs": {
    "url": "https://github.com/Bobnoddle/oc-pr-gui/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "bun test src",
    "prepublishOnly": "bun run typecheck && bun test src && bun run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "effect": "4.0.6",
    "solid-js": "1.9.9",
    "typescript": "5.8.2",
    "vite": "7.1.5",
    "vite-plugin-solid": "2.11.8"
  }
}
